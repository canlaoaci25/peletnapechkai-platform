{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceArticleId", "locale", "slug", "title", "summary", "body"],
        "properties": {
          "sourceArticleId": { "type": "string", "format": "uuid" },
          "locale": { "type": "string" },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 240 },
          "title": { "type": "string", "minLength": 1, "maxLength": 180 },
          "summary": { "type": "string", "maxLength": 500 },
          "body": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
