{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "summary", "body", "seoTitle", "seoDescription", "imageAltText", "sources"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 240 },
          "title": { "type": "string", "minLength": 20, "maxLength": 180 },
          "summary": { "type": "string", "minLength": 80, "maxLength": 500 },
          "body": { "type": "string", "minLength": 2500 },
          "seoTitle": { "type": ["string", "null"], "maxLength": 180 },
          "seoDescription": { "type": ["string", "null"], "maxLength": 320 },
          "imageAltText": { "type": ["string", "null"], "maxLength": 500 },
          "sources": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "url"],
              "properties": {
                "name": { "type": "string", "minLength": 2, "maxLength": 200 },
                "url": { "type": "string", "pattern": "^https?://", "maxLength": 2048 }
              }
            }
          }
        }
      }
    }
  }
}
